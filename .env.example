# ── Arkan AI Solutions — environment configuration ──────────────────────────
# Copy this file to `.env` and fill the values. All variables are optional;
# sensible fallbacks exist for everything except the lead webhook.

# Lead form endpoint (REQUIRED for the form to submit).
# Any HTTPS endpoint accepting POST application/json works.
# Recommended: an n8n Webhook node (Respond immediately, 200).
#   Example: https://n8n.your-domain.com/webhook/arkan-leads
# Payload shape: see README.md → "Lead webhook".
# If unset, the form will NOT fake success — it offers WhatsApp/email fallback.
VITE_LEAD_WEBHOOK_URL=

# Public site URL (used for canonical/og tags and sitemap consistency)
VITE_SITE_URL=https://arkan.ai

# WhatsApp number in international format, digits only
VITE_WHATSAPP=201007725744

# Contact email
VITE_EMAIL=hello@arkan.ai

# Calendar booking link (Google appointment schedule, Cal.com, Calendly…)
VITE_CALENDAR_URL=https://calendar.app.google/35V4etCwYoD5poM77

# Optional Plausible domain — if set, window.plausible events are sent
VITE_PLAUSIBLE_DOMAIN=
